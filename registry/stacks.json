  "automation_frameworks": {
    "instruction": "Bound automatically from the detected stack target. If the repo already has an automation framework installed, that one WINS over the default - never introduce a second framework alongside an existing one. If the repo has none and two are equally viable for the target, ask the user to choose between exactly those two.",
    "web": [
      {
        "id": "playwright",
        "label": "Playwright",
        "languages": [
          "typescript",
          "javascript"
        ],
        "markers": [
          "playwright.config.ts",
          "playwright.config.js",
          "@playwright/test"
        ],
        "install": "npm install -D @playwright/test && npx playwright install",
        "run": "npx playwright test",
        "artifacts": [
          "screenshots",
          "videos",
          "traces"
        ],
        "default_for": [
          "typescript",
          "react",
          "vue",
          "go",
          "rust",
          "php",
          "generic"
        ],
        "strengths": "Cross-browser, auto-wait, trace viewer, parallel by default. The default choice for new web automation."
      },
